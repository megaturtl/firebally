# Keep client-side input templates out of server-side macro expansion
data modify storage firebally:config dialog set value {"type":"minecraft:confirmation","title":"Firebally Config","body":{"type":"minecraft:plain_message","contents":"Use whole numbers. Save applies all settings.","width":300},"inputs":[{"type":"minecraft:number_range","key":"cooldown","label":"Fireball cooldown (seconds)","width":300,"start":0,"end":600,"step":10},{"type":"minecraft:number_range","key":"power","label":"Max fireball power","width":300,"start":1,"end":127,"step":1},{"type":"minecraft:number_range","key":"ramp_distance","label":"Distance before max power (chunks)","width":300,"start":0,"end":10,"step":1},{"type":"minecraft:number_range","key":"speed","label":"Speed (blocks/second)","width":300,"start":1,"end":200,"step":1},{"type":"minecraft:number_range","key":"start_delay","label":"Game start delay (seconds)","width":300,"start":0,"end":600,"step":10},{"type":"minecraft:boolean","key":"show_hunter_cooldown","label":"Show hunter cooldown in tablist","on_true":"1","on_false":"0"},{"type":"minecraft:boolean","key":"apply_start_effects","label":"Apply effects to hunters on game start","on_true":"1","on_false":"0"},{"type":"minecraft:boolean","key":"protect_last_interactor","label":"Protect the last player to interact with a fireball","on_true":"1","on_false":"0"}],"yes":{"label":"Save","action":{"type":"minecraft:dynamic/run_command","template":"function firebally:config/apply {cooldown:\"$(cooldown)\",power:\"$(power)\",ramp_distance:\"$(ramp_distance)\",speed:\"$(speed)\",start_delay:\"$(start_delay)\",show_hunter_cooldown:\"$(show_hunter_cooldown)\",apply_start_effects:\"$(apply_start_effects)\",protect_last_interactor:\"$(protect_last_interactor)\"}"}},"no":{"label":"Cancel"}}
execute store result storage firebally:config cooldown int 1 run scoreboard players get #fireball_cooldown_seconds fb_config
execute store result storage firebally:config power int 1 run scoreboard players get #fireball_power fb_config
execute store result storage firebally:config ramp_distance int 1 run scoreboard players get #fireball_power_ramp_distance_chunks fb_config
execute store result storage firebally:config speed int 1 run scoreboard players get #fireball_speed_blocks_per_second fb_config
execute store result storage firebally:config start_delay int 1 run scoreboard players get #game_start_delay_seconds fb_config
execute store result storage firebally:config show_hunter_cooldown int 1 run scoreboard players get #show_hunter_cooldown fb_config
execute store result storage firebally:config apply_start_effects int 1 run scoreboard players get #apply_start_effects fb_config
execute store result storage firebally:config protect_last_interactor int 1 run scoreboard players get #protect_last_interactor fb_config
function firebally:config/prefill with storage firebally:config